[Unit]
Description=P16 personal mixer
After=network.target sound.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/opt/p16mix
Environment=PYTHONPATH=/opt/p16mix
ExecStart=/usr/bin/python3 -m p16mix --host 0.0.0.0 --port 8080 --demo --serial /dev/ttyACM0 --state /var/lib/p16mix/state.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
